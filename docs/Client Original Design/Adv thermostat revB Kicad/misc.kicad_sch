  (text "~{Si2302CDS}\nVds = 20V\nId = 2.9A\nVgs(th)= 850mV" (at 111.76 80.01 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 47fa5c7f-a4f7-4b55-821a-6370719b415e)
  )
  (text "TABLET PWR & RST KEYS" (at 95.25 99.06 0)
    (effects (font (size 2.9972 2.9972) (thickness 0.5994) bold) (justify left bottom))
    (uuid 4951ed07-6f11-45d8-963d-31a274b0fba7)
  )
  (text "Max current per individual SK6812 at max brightness is 40mA.\nTotal max current for 4 x SK6812 is 160mA on the +5V rail."
    (at 91.44 114.3 0)
    (effects (font (size 1 1)) (justify left bottom))
    (uuid 63819f26-0510-4a86-bf7f-417fe57c764e)
  )
  (text "TODO: Test behaviour when running on battery which may result in low VBAT!"
    (at 17.78 157.48 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 68de89ad-a748-4314-8950-7bb3ac2932c7)
  )
  (text "TABLET INTERFACE" (at 109.22 57.15 0)
    (effects (font (size 2.9972 2.9972) (thickness 0.5994) bold) (justify left bottom))
    (uuid 7a8a62ba-cd39-44de-8805-85ab034d9b66)
  )
  (text "*interface with tablet 10 pins JST-SH 1A 50VDC rating, pinout contains:\n\n10. RESETKEY (output going to tablet, pulled high by tablet to 1V8, need to be pulled down via mosfet to GND)\n9. PWRKEY (output going to tablet, pulled high by tablet to VBAT, needs to be pulled down via mosfet by ESP32)\n8. TX		(with voltage translation 1V8 > 3V3 so that ESP32 can talk to tablet processor)\n7. RX		(with voltage translation 1V8 > 3V3 so that ESP32 can talk to tablet processor)\n6. VUSB (output going to tablet USB for power & charging)\n5. VUSB (output going to tablet USB for power & charging)\n4. VBAT (input coming from battery)\n3. GND\n2. 1V8 (input coming from tablet)\n1. GND\n\nBattery on tablet is not needed so VBAT is not used in this revision!"
    (at 43.18 45.72 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 81c9c6cd-9a6f-4247-b055-3aa13a57f619)
  )
  (text "PWRKEY (pulled high by tablet to VBAT)\nRESETKEY (pulled high by tablet to 1V8)"
    (at 27.94 97.79 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid a2ae4dd0-6180-48cd-88b8-2d1451b2c40a)
  )
  (text "If a UART connection between Android tablet and ESP32 is not needed\nparts of this schematic will be DNP!"
    (at 159.385 19.685 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid a3b0f693-22b1-4dd7-a788-17ed09e0da83)
  )
  (text "RGB LEDs" (at 129.54 160.02 0)
    (effects (font (size 2.9972 2.9972) (thickness 0.5994) bold) (justify left bottom))
    (uuid b71c4c25-6213-4fea-828c-33b358337f0c)
  )
  (text "UART LEVEL CONVERSION" (at 220.98 66.04 0)
