  (text "BSEC: Bosch Sensortec Environmental Cluster\nBSEC precisely performs several calculations outside the device such as ambient air temperature, ambient relative humidity, pressure and air quality (IAQ) level.\nhttps://www.bosch-sensortec.com/software-tools/software/bsec/\nhttps://github.com/BoschSensortec/BSEC-Arduino-library"
    (at 15.24 191.77 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 29b53240-22cc-436e-b90a-d83a737ee108)
  )
