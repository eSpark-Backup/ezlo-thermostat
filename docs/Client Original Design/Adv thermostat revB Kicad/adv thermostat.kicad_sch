  (text "RADAR" (at 213.36 62.23 90)
    (effects (font (size 1.27 1.27) (thickness 0.254) bold) (justify left bottom))
    (uuid 22f257e3-5a71-4ec8-9faa-a1a169a3a76c)
  )
  (text "Relays, depending on the channel, switch between COM and 24VAC or RH wire\n\nY, G, O are switched betwen COM and 24VAC (RC)\nW, B  are switched between COM and RH wire\n\nIf C-wire is absent, 24VAC is absent, only W and B are switched to RH wire. \n"
    (at 166.37 132.08 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 26fc84a5-6645-44f3-aa8e-1036bcdf41bf)
