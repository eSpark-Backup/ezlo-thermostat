  (text "These LEDs are likely\nnot needed in production!" (at 20.32 117.475 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 5ad5bef2-53d9-4258-9b4f-e8d3e7de142c)
  )
  (text "SENSOR SPI" (at 148.59 78.74 90)
    (effects (font (size 1 1)) (justify left bottom))
    (uuid 7cf975bb-f8ac-4699-b677-970f86c1ec2a)
  )
  (text "JTAG" (at 148.59 88.9 90)
    (effects (font (size 1 1)) (justify left bottom))
    (uuid 8358aa55-0a16-47ef-9184-5d0e2e6afdef)
  )
  (text "Strapping pins\n• BOOT = IO0\n• JTAG = IO3\n• VSPI = IO45\n• LOG = IO46\n\nSPI0/1: GPIO26-32 are usually used for SPI flash and PSRAM and not recommended for other uses.\nWhen using Octal Flash or Octal PSRAM or both, GPIO33~37 are connected to SPIIO4 ~ SPIIO7 and \nSPIDQS. Therefore on ESP32-S3R8 / ESP32-S3R8V board GPIO33~37 are also not recommended for \nother uses.\n\nUSB-JTAG: GPIO 19 and 20 are used by USB-JTAG by default. In order to use them as GPIOs, \nUSB-JTAG will be disabled by the drivers.\n"
    (at 26.67 187.96 0)
    (effects (font (size 1.5 1.5)) (justify left bottom))
    (uuid c310f19c-8088-4e99-a57c-e063f7320af3)
  )

